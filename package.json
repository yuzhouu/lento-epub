{
  "name": "lento-epub-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode web --host 127.0.0.1 --port 4178",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run build:web && npm run build:extension",
    "build:web": "vite build --mode web",
    "build:extension": "vite build --mode extension",
    "check:store": "node scripts/check-store-assets.mjs",
    "release:extension": "npm run test && npm run typecheck && npm run build:extension && npm run check:store && node scripts/package-extension.mjs",
    "preview": "vite preview --mode web --host 127.0.0.1 --port 4178"
  },
  "dependencies": {
    "epubjs": "^0.3.93",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.13"
  }
}
