{
  "name": "卷舍 · Lento EPUB 阅读器",
  "short_name": "卷舍 · Lento",
  "description": "一个安静、简洁、数据留在本地的 EPUB 阅读器。",
  "lang": "zh-CN",
  "id": ".",
  "start_url": ".",
  "scope": ".",
  "display": "standalone",
  "background_color": "#f5f2eb",
  "theme_color": "#f5f2eb",
  "file_handlers": [
    {
      "action": ".",
